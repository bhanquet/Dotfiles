{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "nord",
    "mode": "system"
  },
  "plugins": [
    "oh-my-opencode-slim"
  ],
  "diffs": {
    "wrap": "word"
  },
  "session": {
    "sidebar": "auto",
    "scrollbar": false,
    "thinking": "show",
    "markdown": "rendered",
    "image_preview": false
  },
  "animations": true,
  "tabs": {
    "layout": "horizontal"
  },
  "terminal": {
    "title": true
  }
}
